option.FXAA_DEFINE.comment=Enables Fast Approximate Anti-Aliasing (FXAA) for smoother images.
value.FXAA_DEFINE.-1=§aOff
value.FXAA_DEFINE.1=§eOn

option.SSAO_QUALI_DEFINE=Ambient Occlusion (SSAO) Quality
option.SSAO_QUALI_DEFINE.comment=Adjusts SSAO quality, adding extra ambient shadows to scene edges. Each level reduces SSAO noise.
value.SSAO_QUALI_DEFINE.0=§aOff
value.SSAO_QUALI_DEFINE.2=§eMedium
value.SSAO_QUALI_DEFINE.3=§cHigh

option.ANISOTROPIC_FILTER=Texture Filtering
option.ANISOTROPIC_FILTER.comment=Uses anisotropic filtering to improve mipmap texture quality. §e[*]§r Ensure "Mipmap Level" in Video Settings is set to maximum (4).
value.ANISOTROPIC_FILTER.0=§aOff
value.ANISOTROPIC_FILTER.4=§e4x
value.ANISOTROPIC_FILTER.8=§e8x
value.ANISOTROPIC_FILTER.16=§4§l16x

option.COLORED_LIGHTING=Advanced Color Tracking§e[*]§r
option.COLORED_LIGHTING.comment=Uses voxelization and fill lighting to add color to block light, while also introducing new light sources. §e[*]§r Only effective on Iris and supported platforms. §e[*]§r Disabled when "Real-Time Shadows" is off. §a[+]§r Advanced Color Tracking also enables other features that can be toggled individually in "Other → ACT Features" menu. §c[-]§r Higher chunk values affect performance far more than expected, each level may consume more than double the performance of the previous. §c[-]§r Colored lighting may produce color leakage when processing non-full/modded blocks.
value.COLORED_LIGHTING.0=§aOff
value.COLORED_LIGHTING.128=§c4 Chunks
value.COLORED_LIGHTING.192=§c6 Chunks
value.COLORED_LIGHTING.256=§4§l8 Chunks
value.COLORED_LIGHTING.384=§4§l12 Chunks
value.COLORED_LIGHTING.512=§4§l§n§o16 Chunks
value.COLORED_LIGHTING.768=§4§l§n§o24 Chunks §r§c[-]
value.COLORED_LIGHTING.1024=§4§k-§r§4§l§n§o32 Chunks§r§4§k- §r§c[-]

option.WORLD_SPACE_REFLECTIONS=World Space Reflections§e[*]§r
option.WORLD_SPACE_REFLECTIONS.comment=Calculates reflections in world space rather than screen space. §e[*]§r Only effective when Advanced Color Tracking is enabled and the system supports it. §e[*]§r Maximum distance depends on Advanced Color Tracking distance, internally limited to 16 chunks for technical reasons. §c[-]§r Severely impacts performance at high Advanced Color Tracking distances. §c[-]§r May have issues with mods or resource packs.
value.WORLD_SPACE_REFLECTIONS.-1=§aOff
value.WORLD_SPACE_REFLECTIONS.1=§4§l§n§oON

option.WORLD_SPACE_REF_MODE=WSR Mode§e[*]§r
option.WORLD_SPACE_REF_MODE.comment=Determines the operating mode of world space reflections. §e[*]§r "WSR Only" mode only shows world space reflections to eliminate screen space reflection artifacts. "WSR+SSR" mode captures more reflection detail because SSR can access all on-screen details without block or distance limitations.
value.WORLD_SPACE_REF_MODE.1=WSR Only
value.WORLD_SPACE_REF_MODE.2=WSR+SSR

option.WORLD_SPACE_PLAYER_REF=Player Reflection
option.WORLD_SPACE_PLAYER_REF.comment=Makes the current player model visible in world space reflections.
value.WORLD_SPACE_PLAYER_REF.-1=Off
value.WORLD_SPACE_PLAYER_REF.1=On

option.SSAO_I=SSAO Intensity
option.SSAO_I.comment=Determines SSAO intensity, adding extra ambient shadows to scene edges. §e[*]§r Ineffective when SSAO is disabled in "Performance Settings".
value.SSAO_I.0=Off

option.VANILLAAO_I=Vanilla AO Intensity
option.VANILLAAO_I.comment=Determines the intensity of Minecraft's vanilla ambient occlusion, adding extra ambient shadows to scene edges.
value.VANILLAAO_I.0=Off

option.BORDER_FOG=Border Fog
option.BORDER_FOG.comment=Dense fog at the edge of the loaded world to hide chunk boundaries. §e[*]§r Recommended to disable when render distance is below 8 chunks.

option.ATM_FOG_MULT=Atmosphere Fog
option.ATM_FOG_MULT.comment=Adjusts the intensity of height-based atmospheric fog.
value.ATM_FOG_MULT.0.50=Very Light
value.ATM_FOG_MULT.0.65=Light
value.ATM_FOG_MULT.0.80=Normal
value.ATM_FOG_MULT.0.95=Dense

option.ATM_FOG_DISTANCE=Atmosphere Fog Distance
option.ATM_FOG_DISTANCE.comment=Adjusts the camera distance at which atmospheric fog begins to appear. §e[*]§r Note that fog distance is also automatically adjusted based on the render distance in Video Settings.

option.ATM_FOG_ALTITUDE=Atmosphere Fog Height
option.ATM_FOG_ALTITUDE.comment=Determines the height at which atmospheric fog is most prominent.

option.CAVE_FOG=Cave Fog
option.CAVE_FOG.comment=Enables additional fog effects in deep underground areas.

option.LIGHTSHAFT_BEHAVIOUR=Light Shaft Behavior
option.LIGHTSHAFT_BEHAVIOUR.comment=Determines light shaft behavior. §a[+]§r Scene-aware light shafts automatically switch between normal and extreme modes for the best effect. §c[-]§r Extreme mode is not recommended for regular gameplay and will severely impact performance.
value.LIGHTSHAFT_BEHAVIOUR.0=Off
value.LIGHTSHAFT_BEHAVIOUR.1=Scene-Aware§a[+]
value.LIGHTSHAFT_BEHAVIOUR.2=Normal
value.LIGHTSHAFT_BEHAVIOUR.3=Extreme§c[-]

option.LIGHTSHAFT_SMOKE=§eLight Shaft Smoke§r
option.LIGHTSHAFT_SMOKE.comment=Adds volumetric smoke to light shafts. §c[-]§r Will severely impact performance.

option.SPECIAL_PALE_GARDEN_LIGHTSHAFTS=Pale Garden Special Light Shafts
option.SPECIAL_PALE_GARDEN_LIGHTSHAFTS.comment=Makes light shafts more special in the "Pale Garden" biome.

option.LIGHTSHAFT_DAY_I=Day Light Shaft Multiplier
option.LIGHTSHAFT_NIGHT_I=Night Light Shaft Multiplier
option.LIGHTSHAFT_RAIN_I=Rain Light Shaft Multiplier

option.LIGHTSHAFT_SUNSET_SATURATION=Sunset Light Shaft Color
option.LIGHTSHAFT_SUNSET_SATURATION.comment=Adjusts the extra saturation of light shaft colors during sunrise/sunset. Higher values shift towards red-orange, lower values towards yellow.

option.CLOUD_STYLE_DEFINE=Cloud Style
option.CLOUD_STYLE_DEFINE.comment=Determines the cloud style. §e[*]§r "Follow Style" means it is automatically determined by the "Visual Style" setting. §e[*]§r The "Vanilla" style requires clouds to be enabled in Video Settings.
value.CLOUD_STYLE_DEFINE.-1=Follow Style
value.CLOUD_STYLE_DEFINE.0=Off
value.CLOUD_STYLE_DEFINE.1=Fantasy
value.CLOUD_STYLE_DEFINE.3=Unbound
value.CLOUD_STYLE_DEFINE.50=Vanilla§e[*]

option.CLOUD_SHADOWS=Cloud Shadows
option.CLOUD_SHADOWS.comment=Enables shadows cast by clouds. §e[*]§r Only effective for "Fantasy" or "Unbound" cloud styles. §e[*]§r Cloud shadows are randomly generated when Cloud Style is set to "Unbound".

option.CLOUD_CLOSED_AREA_CHECK=Indoor No Clouds
option.CLOUD_CLOSED_AREA_CHECK.comment=Performs additional checks to remove clouds in enclosed areas. §e[*]§r Only effective for "Fantasy" or "Unbound" cloud styles. §e[*]§r Disabled when "Real-Time Shadows" is off.

option.CLOUD_ALT1=Cloud Height§e[*]§r
option.CLOUD_ALT1.comment=Determines the world height at which clouds appear. §e[*]§r May increase or decrease automatically based on dimension settings and mods. §e[*]§r Only effective for "Fantasy" or "Unbound" cloud styles.

option.CLOUD_SPEED_MULT=Cloud Speed
option.CLOUD_SPEED_MULT.comment=Determines the speed of cloud movement. "Sync with World Time" uses the Minecraft world time to advance cloud positions, making them consistent for all players on the same server. §e[*]§r Only effective for "Fantasy" or "Unbound" cloud styles.
value.CLOUD_SPEED_MULT.100=Sync with World Time

option.CLOUD_R=Cloud Red Multiplier
option.CLOUD_G=Cloud Green Multiplier
option.CLOUD_B=Cloud Blue Multiplier

option.CLOUD_UNBOUND_AMOUNT=Cloud Amount
option.CLOUD_UNBOUND_AMOUNT.comment=Adjusts the number of unbound clouds.

option.CLOUD_UNBOUND_SIZE_MULT=Cloud Size§c[-]§r
option.CLOUD_UNBOUND_SIZE_MULT.comment=Adjusts the size of unbound clouds, higher values produce smaller cloud puffs. §c[-]§r Changing this setting will disable the cloud sync feature.

option.CLOUD_UNBOUND_RAIN_ADD=Rainy Cloud Addition
option.CLOUD_UNBOUND_RAIN_ADD.comment=Adjusts the increase in cloud cover during rain/snow.
prefix.CLOUD_UNBOUND_RAIN_ADD=+

option.DOUBLE_REIM_CLOUDS=Double Fantasy Clouds
option.DOUBLE_REIM_CLOUDS.comment=Enables a second layer of fantasy clouds. §e[*]§r Only effective for "Fantasy" cloud style.

option.CLOUD_ALT2=Cloud Second Layer Height
option.CLOUD_ALT2.comment=Determines the world height at which the second cloud layer appears. §e[*]§r Only effective when "Double Fantasy Clouds" is enabled and using "Fantasy" cloud style.

option.NETHER_STORM=§eNether Storm§r
option.NETHER_STORM.comment=Adds a smoke-like volumetric effect to the Nether dimension. §c[-]§r Will affect performance.

option.NETHER_STORM_I=Nether Storm Opacity
option.NETHER_STORM_I.comment=Adjusts the opacity of the Nether storm.

option.NETHER_STORM_LOWER_ALT=Nether Storm Low Point Height
option.NETHER_STORM_LOWER_ALT.comment=Determines the lower starting point of the Nether storm. The Nether storm does not appear below this height, and is brightest right above it.

option.NETHER_STORM_HEIGHT=Nether Storm Height
option.NETHER_STORM_HEIGHT.comment=Determines the height at which the Nether storm forms. Lowering this value causes the Nether storm to gather near the low point height.

option.NETHER_VIEW_LIMIT=§eNether Visibility§r
option.NETHER_VIEW_LIMIT.comment=Determines the maximum distance of fog visibility in the Nether. §c[-]§r Increasing this value while the Nether storm is enabled may affect performance.
