#Settings
option.RP_MODE=RP Support
option.RP_MODE.comment=Changes multiple internal calculations to determine how different blocks and materials are rendered. §bIntegrated PBR+§r: Computational PBR and extra effects, highly recommended. §aBasic§r: No PBR or extra effects. §elabPBR/seuspbr§r: Materials using a required PBR resource pack.
value.RP_MODE.0=§aBasic
value.RP_MODE.1=§bIntegrated PBR+
value.RP_MODE.2=§eseuspbr (Requires RP)
value.RP_MODE.3=§elabPBR (Requires RP)

option.COLOR_LIGHT_MODE=Simulated Color Lighting §c[Apple Devices]§r
option.COLOR_LIGHT_MODE.comment=§cApple devices do not support native colored light sources; this is an alternative technology. §r§aTrue Color§r: Glowing ores + emissive blocks + highlighted emission simulate a colored lighting environment. §eEnhanced Color§r: Additionally overlays time-of-day light color curves to simulate warm/cool color temperature shifts. §cOff§r: No color simulation applied.
value.COLOR_LIGHT_MODE.0=§cOff
value.COLOR_LIGHT_MODE.1=§aTrue Color
value.COLOR_LIGHT_MODE.2=§eEnhanced Color

option.WATER_REFLECT_QUALITY=Water Reflection Quality
option.WATER_REFLECT_QUALITY.comment=Adjusts the visual quality of reflections on translucent objects. §cMedium§r: Screen-space ray-traced reflections. §ePotato§r: A faster alternative method, may be inaccurate in some cases. §aOff§r: No reflections.
value.WATER_REFLECT_QUALITY.-1=§aOff
value.WATER_REFLECT_QUALITY.0=§aSky Only
value.WATER_REFLECT_QUALITY.1=§ePotato
value.WATER_REFLECT_QUALITY.2=§cMedium

option.BLOCK_REFLECT_QUALITY=Block Reflection Quality§e[*]§r
option.BLOCK_REFLECT_QUALITY.comment=Adjusts the visual quality of reflections on solid materials. §cHigh§r: Sun/Moon specular highlights + advanced specular reflections. §eLow§r: Sun/Moon specular highlights only. §e[*]§r RP Support must be set to non-basic for specular reflections.
value.BLOCK_REFLECT_QUALITY.0=§aOff
value.BLOCK_REFLECT_QUALITY.1=§eLow
value.BLOCK_REFLECT_QUALITY.3=§cHigh

option.SHADOW_QUALITY=Real-Time Shadows
option.SHADOW_QUALITY.comment=Adjusts shadow quality, reducing noise artifacts at each level. §eLow§r and §eVery Low§r use simpler filtering, §eVery Low§r also disables colored shadows, §aOff§r completely disables shadows and light shafts. §e[*]§r Internally limited to "Low" when temporal filtering is disabled or pixelated shadows are enabled.
value.SHADOW_QUALITY.-1=§aOff
value.SHADOW_QUALITY.0=§eVery Low
value.SHADOW_QUALITY.1=§eLow
value.SHADOW_QUALITY.2=§eMedium
value.SHADOW_QUALITY.3=§cHigh
value.SHADOW_QUALITY.4=§cVery High
value.SHADOW_QUALITY.5=§4§lUltra

option.LIGHTSHAFT_QUALI_DEFINE=Light Shaft Quality§e[*]§r
option.LIGHTSHAFT_QUALI_DEFINE.comment=Adjusts light shaft quality, reducing noise at each level. §e[*]§r "Real-Time Shadows" must be non-off for light shafts to work. §e[*]§r Also controls End light shaft quality; "Off" is treated as "Low".
value.LIGHTSHAFT_QUALI_DEFINE.0=§aOff
value.LIGHTSHAFT_QUALI_DEFINE.1=§eLow
value.LIGHTSHAFT_QUALI_DEFINE.2=§eMedium
value.LIGHTSHAFT_QUALI_DEFINE.3=§cHigh
value.LIGHTSHAFT_QUALI_DEFINE.4=§4§lVery High

option.shadowDistance=Shadow Distance
option.shadowDistance.comment=Adjusts the distance around the player for rendering real-time shadows. §c[-]§r Lower values may cause excessive light shaft leakage.
value.shadowDistance.64.0=§a4 Chunks§c[-]
value.shadowDistance.80.0=§a5 Chunks§c[-]
value.shadowDistance.96.0=§a6 Chunks§c[-]
value.shadowDistance.112.0=§a7 Chunks§c[-]
value.shadowDistance.128.0=§a8 Chunks
value.shadowDistance.160.0=§e10 Chunks
value.shadowDistance.192.0=§e12 Chunks
value.shadowDistance.224.0=§e14 Chunks
value.shadowDistance.256.0=§c16 Chunks
value.shadowDistance.320.0=§c20 Chunks
value.shadowDistance.384.0=§4§l24 Chunks
value.shadowDistance.512.0=§4§l32 Chunks
value.shadowDistance.768.0=§4§l§n§o48 Chunks
value.shadowDistance.1024.0=§4§k-§r§4§l§n§o64 Chunks§r§4§k-

option.ENTITY_SHADOW=Entity Shadows
option.ENTITY_SHADOW.comment=Enables shadows cast by entities and block entities. "Normal Entities" includes animals and monsters, "All" also includes block entities like chests. §c[-]§r Entity shadows affect performance far more than expected, in some cases consuming over 50% of FPS.
value.ENTITY_SHADOW.-1=§aOff
value.ENTITY_SHADOW.1=§cNormal Entities
value.ENTITY_SHADOW.2=§4§k-§r§4§l§n§oAll§r§4§k- §r§c[-]

option.DETAIL_QUALITY=Detail Quality
option.DETAIL_QUALITY.comment=Adjusts multiple small features that affect performance: water materials, TAA, lighting tweaks, night nebulae, Nether storms, sky reflections, puddle precision, waving effects, motion blur.
value.DETAIL_QUALITY.0=§aPotato
value.DETAIL_QUALITY.2=§eMedium
value.DETAIL_QUALITY.3=§cHigh

option.CLOUD_QUALITY=Cloud Quality
option.CLOUD_QUALITY.comment=Adjusts the lighting, detail, and sampling quality of Fantasy/Unbound cloud styles. §e[*]§r Only effective when Cloud Style is set to "Fantasy" or "Unbound".
value.CLOUD_QUALITY.0=§aOff
value.CLOUD_QUALITY.1=§aLow
value.CLOUD_QUALITY.2=§eMedium
value.CLOUD_QUALITY.3=§cHigh

